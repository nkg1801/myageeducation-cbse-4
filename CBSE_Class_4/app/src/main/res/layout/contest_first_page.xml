<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="10dip">

    <TextView
        android:id="@+id/textViewDateRange"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:textSize="14sp"
        android:text="Contest starts from 10th of the month to the end of every month" />

    <Button
        android:id="@+id/startContest"
        android:layout_width="150dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/textViewDateRange"
        android:layout_alignParentRight="true"
        android:layout_alignParentLeft="true"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="Start Contest"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button_dark_grey"
        android:onClick="onClickStartContest"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <Button
        android:id="@+id/buttonContestRegistration"
        android:layout_width="150dp"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/startContest"
        android:layout_alignParentRight="true"
        android:layout_alignParentLeft="true"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="Contest Registration"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button_red"
        android:onClick="onClickContestRegistration"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:id="@+id/textViewContestFlash"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/buttonContestRegistration"
        android:layout_above="@+id/viewLine"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal|center_vertical"
        android:textSize="25sp"
        android:text="Participate and win exciting prizes" />

    <ImageView
        android:id="@+id/imageViewContestFlash"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/buttonContestRegistration"
        android:layout_above="@+id/viewLine"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal|center_vertical"
        android:scaleType="fitCenter"
        android:visibility="invisible"/>

    <Button
        android:id="@+id/buttonContestRules"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/adView"
        android:text="Contest Rules"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button_dark_green"
        android:onClick="onClickContestRules"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <TextView
        android:id="@+id/textViewSeparator"
        android:layout_width="1dp"
        android:layout_height="100dp"
        android:layout_above="@+id/buttonContestRules"
        android:layout_centerHorizontal="true"
        />

    <Button
        android:id="@+id/buttonPrizeforWinners"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginBottom="5dp"
        android:layout_marginRight="5dp"
        android:layout_above="@+id/buttonContestRules"
        android:layout_alignLeft="@+id/buttonContestRules"
        android:layout_toLeftOf="@+id/textViewSeparator"
        android:text="Prize for Winners"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button_blue"
        android:onClick="onClickPrizesForWinners"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <Button
        android:id="@+id/buttonWinnersOfPastContests"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/buttonContestRules"
        android:layout_toRightOf="@+id/textViewSeparator"
        android:text="Past Winners"
        android:layout_marginLeft="5dp"
        android:layout_alignRight="@+id/buttonContestRules"
        android:textColor="#000000"
        android:background="@drawable/rounded_button_yellow"
        android:onClick="onClickWinnersOfPastContests"
        android:textAppearance="?android:attr/textAppearanceMedium" />

    <View
        android:id="@+id/viewLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/buttonWinnersOfPastContests"
        android:layout_marginBottom="10dp"
        android:background="@android:color/darker_gray"/>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        ads:adSize="SMART_BANNER"
        ads:adUnitId="@string/admob_banner_adunitid">
    </com.google.android.gms.ads.AdView>

</RelativeLayout>